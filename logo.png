<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <!-- Shadow & Glows -->
    <filter id="drop-shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#000" flood-opacity="0.6"/>
    </filter>
    
    <filter id="glow-blue" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="8" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>

    <!-- Gradients -->
    <radialGradient id="bg-grad" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#1a2636"/>
      <stop offset="50%" stop-color="#0d111a"/>
      <stop offset="100%" stop-color="#05070a"/>
    </radialGradient>

    <linearGradient id="border-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2a456c"/>
      <stop offset="50%" stop-color="#121a24"/>
      <stop offset="100%" stop-color="#1e2c3d"/>
    </linearGradient>

    <linearGradient id="stroke-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00d2ff"/>
      <stop offset="100%" stop-color="#0072ff"/>
    </linearGradient>

    <linearGradient id="wave-grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00d2ff"/>
      <stop offset="50%" stop-color="#00ff87"/>
      <stop offset="100%" stop-color="#ffdf00"/>
    </linearGradient>

    <linearGradient id="btn-blue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00c6ff"/>
      <stop offset="100%" stop-color="#0072ff"/>
    </linearGradient>
    
    <radialGradient id="lens-glass" cx="35%" cy="35%" r="60%">
      <stop offset="0%" stop-color="#1a3b5c"/>
      <stop offset="40%" stop-color="#091422"/>
      <stop offset="95%" stop-color="#020509"/>
    </radialGradient>

    <radialGradient id="lens-reflection" cx="40%" cy="30%" r="50%">
      <stop offset="0%" stop-color="#a5f3fc" stop-opacity="0.8"/>
      <stop offset="50%" stop-color="#00d2ff" stop-opacity="0.2"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
    </radialGradient>

    <!-- Clip Path for App Icon -->
    <clipPath id="icon-clip">
      <rect x="16" y="16" width="480" height="480" rx="105" ry="105" />
    </clipPath>
  </defs>

  <!-- Base App Icon Container with Smooth Corners -->
  <g filter="url(#drop-shadow)">
    <!-- Background Card -->
    <rect x="16" y="16" width="480" height="480" rx="105" ry="105" fill="url(#bg-grad)" stroke="url(#border-grad)" stroke-width="4"/>
    
    <!-- Subtle Inner Glow Border -->
    <rect x="18" y="18" width="476" height="476" rx="103" ry="103" fill="none" stroke="#ffffff" stroke-opacity="0.12" stroke-width="2"/>
  </g>

  <!-- Icon Contents (Clipped to stay inside smooth bounds) -->
  <g clip-path="url(#icon-clip)">
    
    <!-- Outer Glows in Background -->
    <circle cx="256" cy="190" r="140" fill="#0072ff" opacity="0.15" filter="url(#glow-blue)" />
    <circle cx="400" cy="380" r="100" fill="#00c6ff" opacity="0.12" filter="url(#glow-blue)" />

    <!-- CAMERA FRAME OVERLAY -->
    <!-- Frame Top-Left -->
    <path d="M 125 210 L 125 110 A 25 25 0 0 1 150 85 L 362 85 A 25 25 0 0 1 387 110 L 387 135" 
          fill="none" stroke="#ffffff" stroke-width="12" stroke-linecap="round" />
    
    <!-- Frame Bottom-Right -->
    <path d="M 387 235 L 387 265 A 25 25 0 0 1 362 290 L 320 290" 
          fill="none" stroke="#ffffff" stroke-width="12" stroke-linecap="round" />

    <!-- Frame Bottom-Left -->
    <path d="M 125 240 L 125 265 A 25 25 0 0 0 150 290 L 180 290" 
          fill="none" stroke="#ffffff" stroke-width="12" stroke-linecap="round" />

    <!-- RECORD RED DOT -->
    <circle cx="348" cy="128" r="14" fill="#ff3b30" />
    <circle cx="348" cy="128" r="18" fill="none" stroke="#ff3b30" stroke-opacity="0.4" stroke-width="3" />

    <!-- CAMERA LENS -->
    <g transform="translate(256, 190)">
      <!-- Outer Metal Ring -->
      <circle cx="0" cy="0" r="88" fill="#11161f" stroke="#2a384c" stroke-width="4" />
      <circle cx="0" cy="0" r="80" fill="#080b10" stroke="#1a2330" stroke-width="3" />
      
      <!-- Lens Ridges -->
      <circle cx="0" cy="0" r="72" fill="none" stroke="#151d2a" stroke-width="5" stroke-dasharray="8 4" />
      <circle cx="0" cy="0" r="64" fill="url(#lens-glass)" stroke="#223147" stroke-width="3" />
      <circle cx="0" cy="0" r="48" fill="#04080e" stroke="#0d1826" stroke-width="2" />
      <circle cx="0" cy="0" r="32" fill="#020407" />

      <!-- Reflection & Highlights -->
      <ellipse cx="-16" cy="-18" rx="28" ry="18" fill="url(#lens-reflection)" transform="rotate(-25 -16 -18)" />
      <circle cx="18" cy="16" r="6" fill="#ffffff" opacity="0.4" />
      <circle cx="-10" cy="-22" r="3" fill="#ffffff" opacity="0.8" />
      <path d="M -35 10 A 40 40 0 0 0 20 38" fill="none" stroke="#00d2ff" stroke-opacity="0.3" stroke-width="3" stroke-linecap="round"/>
    </g>

    <!-- COLORFUL DRAWING WAVE -->
    <path d="M 160 270 Q 185 240 210 265 T 260 265 T 310 260 T 330 250" 
          fill="none" stroke="url(#wave-grad)" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" />

    <!-- MARKER / PEN -->
    <g transform="translate(325, 230) rotate(-35)">
      <!-- Body -->
      <rect x="-10" y="-35" width="20" height="40" rx="4" fill="#ffffff" />
      <!-- Dark Cap Base -->
      <rect x="-10" y="-35" width="20" height="10" fill="#1c2533" />
      <!-- Clip -->
      <rect x="-12" y="-30" width="4" height="25" rx="1" fill="#2d3b52" />
      <!-- Pen Tip Holder -->
      <path d="M -8 5 L 8 5 L 5 18 L -5 18 Z" fill="#2d3b52" />
      <!-- Yellow Tip -->
      <path d="M -4 18 L 4 18 L 0 27 Z" fill="#ffdf00" />
    </g>

    <!-- TEXT: LOUSA -->
    <text x="256" y="360" 
          font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" 
          font-weight="900" 
          font-size="52" 
          fill="#ffffff" 
          text-anchor="middle" 
          letter-spacing="2">LOUSA</text>

    <!-- TEXT: CAM + 2.0 BADGE -->
    <g transform="translate(256, 415)">
      <!-- CAM Text -->
      <text x="-35" y="0" 
            font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" 
            font-weight="300" 
            font-size="46" 
            fill="#ffffff" 
            text-anchor="end" 
            letter-spacing="2">CAM</text>

      <!-- 2.0 Badge Background -->
      <rect x="-18" y="-36" width="96" height="44" rx="14" fill="url(#btn-blue)" />
      
      <!-- 2.0 Badge Text -->
      <text x="30" y="-4" 
            font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" 
            font-weight="800" 
            font-size="30" 
            fill="#ffffff" 
            text-anchor="middle">2.0</text>
    </g>

  </g>
</svg>
